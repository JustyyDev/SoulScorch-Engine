var curScale = 1.0;
var curSing = 4.0;
var camOffsetX = 0.0;
var camOffsetY = 0.0;
var isGhost = true;
var isFlipped = false;

function onCreate() {
    showToast("Loaded Actor Studio Controller", false);
}

function onUpdateScale(val) {
    curScale = val;
}

function onUpdateSing(val) {
    curSing = val;
}

function onUpdateCamX(val) {
    camOffsetX = val;
}

function onUpdateCamY(val) {
    camOffsetY = val;
}

function onToggleGhost(val) {
    isGhost = val;
    showToast("Ghost Overlay: " + (isGhost ? "ON" : "OFF"), false);
}

function onToggleFlip(val) {
    isFlipped = val;
}

function onSaveActor() {
    showToast("Saved character profile to .xmsoul format.", false);
}

function onReloadAtlas() {
    showToast("Sparrow Atlas re-parsed from disk.", false);
}

function onExit() {
    FlxG.switchState(new MainMenuState());
}