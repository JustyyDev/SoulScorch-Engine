activeBpm = 120.0
scrollSpeed = 2.0
stageBound = "stage"
activeStrumline = 2
player1 = "bf"
player2 = "dad"
snapDivision = 16
isPlaying = false
metronomeEnabled = false
hitsoundsEnabled = false
songPosition = 0.0
instVolume = 1.0
vocalVolume = 1.0
playbackRate = 1.0
hitsoundVolume = 0.7
metronomeVolume = 0.6
audioOffset = 0.0
sustainSteps = 0.0
activeNoteType = "normal"
currentEventName = "Camera Focus"
eventVal1 = ""
eventVal2 = ""
chartNotes = []
undoStack = []
redoStack = []
songSections = 1

on create:
    trace("SoulScorch Chart Studio [Ultimate DAW Hybrid Matrix] - Initialized.")
    songPosition = 0.0
    chartNotes = []
    undoStack = []
    redoStack = []
    songSections = 1

on update:
    if (isPlaying) {
        songPosition += (FlxG.elapsed * 1000.0) * playbackRate
    }

function onTogglePlayback() {
    isPlaying = !isPlaying
    trace(isPlaying ? "DAW Playback Started" : "DAW Playback Paused")
}

function onTogglePracticeBench() {
    trace("Toggled Practice Bench Mode")
}

function onSaveSoulChart() {
    trace("Successfully serialized chart buffer to .xmsoul format!")
}

function onExportLegacyJson() {
    trace("Exporting chart buffer to legacy FNF chart JSON format...")
}

function onReloadChart() {
    trace("Reloading chart buffer from disk cache...")
}

function onUndo() {
    if (chartNotes.length > 0) {
        lastNote = chartNotes.pop()
        undoStack.push(lastNote)
        trace("Undo executed.")
    } else {
        trace("Undo queue is empty.")
    }
}

function onRedo() {
    if (undoStack.length > 0) {
        restoredNote = undoStack.pop()
        chartNotes.push(restoredNote)
        trace("Redo executed.")
    } else {
        trace("Redo queue is empty.")
    }
}

function onToggleMetronome() {
    metronomeEnabled = !metronomeEnabled
    trace("Metronome toggled")
}

function onToggleHitsounds() {
    hitsoundsEnabled = !hitsoundsEnabled
    trace("Hitsounds toggled")
}

function onTestInGame() {
    trace("Launching test PlayState session...")
}

function onExit() {
    trace("Exiting Chart Studio workspace...")
    FlxG.switchState(new soulscorch.ui.menus.states.MainMenuState())
}

function onChangeBPM(val) {
    activeBpm = val
    trace("Master BPM updated: " + val)
}

function onChangeSpeed(val) {
    scrollSpeed = val
    trace("Scroll Speed updated: " + val)
}

function onChangeStage(val) {
    stageBound = val
    trace("Stage updated: " + val)
}

function onChangeStrumline(val) {
    activeStrumline = Std.int(val)
    trace("Active Strumline updated: " + activeStrumline)
}

function onChangePlayer(val) {
    player1 = val
    trace("Player 1 updated: " + val)
}

function onChangeOpponent(val) {
    player2 = val
    trace("Player 2 updated: " + val)
}

function onSetInstVol(val) {
    instVolume = val
    trace("Inst volume set")
}

function onSetVoiceVol(val) {
    vocalVolume = val
    trace("Vocal volume set")
}

function onChangePlaybackRate(val) {
    playbackRate = val
    trace("Playback rate set")
}

function onSetHitsoundVol(val) {
    hitsoundVolume = val
    trace("Hitsound volume set")
}

function onSetMetroVol(val) {
    metronomeVolume = val
    trace("Metronome volume set")
}

function onToggleVocalWaveform() {
    trace("Toggled vocal waveform rendering.")
}

function onToggleInstWaveform() {
    trace("Toggled instrumental waveform rendering.")
}

function onChangeAudioOffset(val) {
    audioOffset = val
    trace("Audio offset updated")
}

function onResyncAudio() {
    songPosition = 0.0
    trace("Forced audio stream re-sync.")
}

function onTapTempo() {
    trace("Tap tempo recorded.")
}

function onChangeSnapDiv(val) {
    snapDivision = Std.int(val)
    trace("Snap division set to: 1/" + snapDivision)
}

function onSetSnap4() { onChangeSnapDiv(4) }
function onSetSnap8() { onChangeSnapDiv(8) }
function onSetSnap12() { onChangeSnapDiv(12) }
function onSetSnap16() { onChangeSnapDiv(16) }
function onSetSnap24() { onChangeSnapDiv(24) }
function onSetSnap32() { onChangeSnapDiv(32) }
function onSetSnap48() { onChangeSnapDiv(48) }
function onSetSnap64() { onChangeSnapDiv(64) }

function onQuantizeSelection() {
    trace("Quantized active notes to grid snap.")
}

function onChangeSustain(val) {
    sustainSteps = val
    trace("Sustain steps updated")
}

function onChangeNoteType(val) {
    activeNoteType = val
    trace("Note type updated")
}

function onCycleNoteType() {
    trace("Cycled note type.")
}

function onSelectEvent(val) {
    currentEventName = val
    trace("Selected event: " + val)
}

function onChangeEventVal1(val) {
    eventVal1 = val
}

function onChangeEventVal2(val) {
    eventVal2 = val
}

function onAddEventAtPlayhead() {
    trace("Added event at playhead.")
}

function onDeleteNote() {
    if (chartNotes.length > 0) {
        chartNotes.pop()
        trace("Deleted note.")
    } else {
        trace("No notes to delete.")
    }
}

function onCopyNotes() {
    trace("Copied pattern selection.")
}

function onPasteNotes() {
    trace("Pasted pattern buffer.")
}

function onSwapLanes() {
    trace("Swapped note lanes.")
}

function onMirrorLanes() {
    trace("Mirrored section lanes.")
}

function onCompressNotes() {
    trace("Compressed note timings.")
}

function onHumanizeOffsets() {
    trace("Applied humanized timing jitter.")
}

function onShiftNotesLeft() {
    trace("Shifted notes left.")
}

function onShiftNotesRight() {
    trace("Shifted notes right.")
}

function onInvertNotes() {
    trace("Inverted note pattern.")
}

function onClearSection() {
    chartNotes = []
    trace("Cleared section notes.")
}

function onAddNewSection() {
    songSections += 1
    trace("Added new section. Total: " + songSections)
}