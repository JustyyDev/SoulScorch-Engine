var tankmanSpr = null;
var tankTalk1 = null;
var tankTalk2 = null;
var bfBeep = null;
var distorto = null;
var timers = [];

function onCreate() {
    FlxTween.tween(game.camGame, {zoom: 1.0}, 0.7, {ease: FlxEase.quadInOut});
    game.camHUD.visible = false;

    // Instantiate Cutscene Tankman
    tankmanSpr = new FunkinSprite(game.dad.x + 520, game.dad.y + 225);
    tankmanSpr.antialiasing = true;
    tankmanSpr.loadSprite(Paths.image("game/cutscenes/tank/ugh-tankman"));
    tankmanSpr.addAnim("1", "TANK TALK 1 P1", 24, false);
    tankmanSpr.addAnim("2", "TANK TALK 1 P2", 24, false);

    game.add(tankmanSpr);
    game.dad.visible = false;

    game.camFollow.setPosition(game.dad.getMidpoint().x + 150, game.dad.getMidpoint().y - 100);

    // Audio & Ambience
    tankTalk1 = FlxG.sound.load(Paths.sound("cutscenes/tank/ugh-1"));
    tankTalk2 = FlxG.sound.load(Paths.sound("cutscenes/tank/ugh-2"));
    bfBeep = FlxG.sound.load(Paths.sound("cutscenes/tank/ugh-beep"));
    
    bfBeep.onComplete = function() {
        game.boyfriend.dance();
    };

    distorto = FlxG.sound.load(Paths.music("DISTORTO"));
    distorto.volume = 0;
    distorto.play();
    distorto.fadeIn(5.0, 0.0, 0.5);

    tankmanSpr.playAnim("1");
    tankTalk1.play();

    // Choreographed Timeline
    addTimer(3.0, function() {
        game.camFollow.setPosition(game.boyfriend.getMidpoint().x - 100, game.boyfriend.getMidpoint().y - 100);

        addTimer(1.5, function() {
            game.boyfriend.playSingAnim(2); // singUP
            bfBeep.play();

            addTimer(1.5, function() {
                game.camFollow.setPosition(game.dad.getMidpoint().x + 150, game.dad.getMidpoint().y - 100);
                tankTalk2.play();
                tankmanSpr.playAnim("2");

                addTimer(6.1, function() {
                    distorto.fadeOut(1.2, 0.0);
                    cleanup();
                });
            });
        });
    });
}

function addTimer(delay, callback) {
    var tmr = new FlxTimer().start(delay, function(_) {
        callback();
    });
    timers.push(tmr);
}

function cleanup() {
    if (tankmanSpr != null) game.remove(tankmanSpr);
    game.camHUD.visible = true;
    game.dad.visible = true;

    for (t in timers) t.cancel();
    if (distorto != null) distorto.stop();
    
    subState.close();
}