<?xml version="1.0" encoding="utf-8"?>
<editor title="MODCHART MATRIX // [STAGE3D &amp; LANE MODIFIERS]" script="data/scripts/editors/modchartMatrix.soul">
    <action label="Play Sequence (Space)" onTrigger="onPlaySequence" />
    <action label="Export .xmsoul (Ctrl+S)" onTrigger="onSaveModifiers" />
    <action label="Exit" onTrigger="onExit" />

    <window id="easeMatrix" title="Lane Transforms" x="15" y="45" width="300" height="320">
        <stepper id="swayXStep" label="Sway Width (X)" default="0.0" min="-500" max="500" step="5" precision="1" x="10" y="8" width="280" action="onSwayX" />
        <stepper id="swayYStep" label="Sway Height (Y)" default="0.0" min="-500" max="500" step="5" precision="1" x="10" y="44" width="280" action="onSwayY" />
        <stepper id="rotStep" label="Receptor Rotation" default="0.0" min="-360" max="360" step="5" precision="1" x="10" y="80" width="280" action="onRotate" />
        <stepper id="alphaStep" label="Strumline Alpha" default="1.0" min="0.0" max="1.0" step="0.05" precision="2" x="10" y="116" width="280" action="onAlpha" />
    </window>

    <window id="shaderMatrix" title="Shader Pipelines" x="955" y="45" width="310" height="240">
        <input id="shaderKeyInput" label="Active SoulShader" text="chromaticAberration" x="10" y="8" width="290" action="onShaderChange" />
        <stepper id="intensityStep" label="Shader Intensity" default="0.0" min="0.0" max="10.0" step="0.1" precision="2" x="10" y="48" width="290" action="onIntensityChange" />
        <checkbox id="applyHUDCheck" label="Affect HUD Camera" checked="false" x="10" y="90" action="onToggleHUDShader" />
    </window>
</editor>