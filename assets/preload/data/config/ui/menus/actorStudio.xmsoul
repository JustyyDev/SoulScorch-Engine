<?xml version="1.0" encoding="utf-8"?>
<editor title="ACTOR STUDIO PRO" script="data/scripts/editors/actorStudio.soul">
    <action label="Save Character XML" onTrigger="onSaveActor" />
    <action label="Reload Atlas" onTrigger="onReloadAtlas" />
    <action label="Exit" onTrigger="onExit" />

    <window id="animMatrix" title="Animation Matrix" x="15" y="45" width="300" height="420">
        <text id="curAnimTxt" text="Anim: idle" x="10" y="4" size="16" color="0xFF00FFCC" />
        <text id="offsetTxt" text="Offset: [0, 0]" x="10" y="26" size="14" color="0xFF888899" />
        <text id="frameInfoTxt" text="Frame: 0/0" x="10" y="48" size="12" color="0xFF888899" />
        <text id="animListTxt" text="idle\nsingLEFT\nsingDOWN\nsingUP\nsingRIGHT" x="10" y="72" size="12" color="0xFFFFFFFF" />
        <button id="addAnimBtn" text="+ Add Anim" x="10" y="345" width="135" height="26" action="onAddAnimModal" />
        <button id="delAnimBtn" text="- Remove" x="155" y="345" width="135" height="26" action="onRemoveAnim" />
    </window>

    <window id="properties" title="Actor Settings" x="955" y="45" width="310" height="270">
        <stepper id="scaleStepper" label="Scale Multiplier" default="1.0" min="0.1" max="8.0" step="0.05" precision="2" x="10" y="8" width="290" action="onUpdateScale" />
        <stepper id="singStepper" label="Sing Hold Duration" default="4.0" min="0.5" max="16.0" step="0.5" precision="1" x="10" y="44" width="290" action="onUpdateSing" />
        <input id="healthIconInput" label="Health Icon Key" text="face" x="10" y="84" width="290" action="onUpdateIcon" />
        <checkbox id="ghostCheck" label="Ghost Overlay (G)" checked="true" x="10" y="128" action="onToggleGhost" />
        <checkbox id="flipCheck" label="Flip X Axis" checked="false" x="160" y="128" action="onToggleFlip" />
    </window>

    <window id="camOffsets" title="Camera Focus Anchor" x="955" y="325" width="310" height="150">
        <stepper id="camXStepper" label="Cam Offset X" default="0.0" min="-900" max="900" step="5.0" precision="1" x="10" y="8" width="290" action="onUpdateCamX" />
        <stepper id="camYStepper" label="Cam Offset Y" default="0.0" min="-900" max="900" step="5.0" precision="1" x="10" y="44" width="290" action="onUpdateCamY" />
    </window>
</editor>