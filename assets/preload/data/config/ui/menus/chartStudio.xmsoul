<?xml version="1.0" encoding="utf-8"?>
<editor title="SOULSCORCH CHART STUDIO // [CODENAME HYBRID MATRIX]" script="data/scripts/editors/chartStudio.soul">
    <action label="Play/Pause (Space)" onTrigger="onTogglePlayback" />
    <action label="Practice Mode (Tab)" onTrigger="onTogglePracticeBench" />
    <action label="Save .xmsoul (Ctrl+S)" onTrigger="onSaveSoulChart" />
    <action label="Undo (Ctrl+Z)" onTrigger="onUndo" />
    <action label="Redo (Ctrl+Y)" onTrigger="onRedo" />
    <action label="Metronome (M)" onTrigger="onToggleMetronome" />
    <action label="Hitsounds (H)" onTrigger="onToggleHitsounds" />
    <action label="Waveform (W)" onTrigger="onToggleWaveform" />
    <action label="Test in Game (Enter)" onTrigger="onTestInGame" />
    <action label="Exit" onTrigger="onExit" />

    <window id="songProps" title="Song &amp; Strumline Setup" x="15" y="45" width="290" height="340">
        <stepper id="bpmStep" label="Master BPM" default="120" min="30" max="500" step="1" precision="1" x="10" y="8" width="270" action="onChangeBPM" />
        <stepper id="speedStep" label="Scroll Speed" default="2" min="0.5" max="8" step="0.05" precision="2" x="10" y="44" width="270" action="onChangeSpeed" />
        <input id="inputStage" label="Stage Bound ID" text="stage" x="10" y="80" width="270" action="onChangeStage" />
        <stepper id="strumlineSelect" label="Active Strumline (0:GF, 1:Dad, 2:BF)" default="2" min="0" max="8" step="1" precision="0" x="10" y="122" width="270" action="onChangeStrumline" />
        <input id="inputPlayer" label="Player 1 (BF)" text="bf" x="10" y="164" width="130" action="onChangePlayer" />
        <input id="inputOpponent" label="Player 2 (Opponent)" text="dad" x="150" y="164" width="130" action="onChangeOpponent" />
        <button id="exportSoulChartBtn" text="Export as .xmsoul Chart" x="10" y="220" width="270" height="26" action="onSaveSoulChart" />
        <button id="exportJsonBtn" text="Export Legacy JSON" x="10" y="252" width="270" height="26" action="onExportLegacyJson" />
        <button id="reloadChartBtn" text="Reload from Disk" x="10" y="284" width="270" height="26" action="onReloadChart" />
    </window>

    <window id="audioMixer" title="Multi-Track Audio &amp; Waveforms" x="15" y="395" width="290" height="260">
        <stepper id="instVolStep" label="Instrumental Volume" default="1" min="0" max="1.5" step="0.05" precision="2" x="10" y="8" width="130" action="onSetInstVol" />
        <stepper id="voiceVolStep" label="Vocal Volume" default="1" min="0" max="1.5" step="0.05" precision="2" x="150" y="8" width="130" action="onSetVoiceVol" />
        <stepper id="rateStep" label="Playback Rate / Pitch" default="1" min="0.25" max="3" step="0.05" precision="2" x="10" y="44" width="270" action="onChangePlaybackRate" />
        <stepper id="hitsoundVolStep" label="Hitsound Volume" default="0.7" min="0" max="1" step="0.05" precision="2" x="10" y="80" width="130" action="onSetHitsoundVol" />
        <stepper id="metroVolStep" label="Metronome Volume" default="0.6" min="0" max="1" step="0.05" precision="2" x="150" y="80" width="130" action="onSetMetroVol" />
        <checkbox id="waveformVoiceCheck" label="Render Vocal Waveform" checked="true" x="10" y="125" action="onToggleVocalWaveform" />
        <checkbox id="waveformInstCheck" label="Render Instrumental Waveform" checked="true" x="10" y="152" action="onToggleInstWaveform" />
        <button id="resyncAudioBtn" text="Force Audio Re-sync (S)" x="10" y="210" width="270" height="26" action="onResyncAudio" />
    </window>

    <window id="quantizationWin" title="Quantization &amp; Snaps" x="975" y="45" width="290" height="190">
        <text id="currentSnapTxt" text="Active Snap: 1/16 (Yellow)" x="10" y="6" size="13" color="0xFFFFFF00" />
        <stepper id="snapDivStep" label="Snap Division (1/X)" default="16" min="1" max="192" step="1" precision="0" x="10" y="28" width="270" action="onChangeSnapDiv" />
        <button id="snap4Btn" text="1/4" x="10" y="68" width="65" height="24" action="onSetSnap4" />
        <button id="snap8Btn" text="1/8" x="80" y="68" width="65" height="24" action="onSetSnap8" />
        <button id="snap12Btn" text="1/12" x="150" y="68" width="65" height="24" action="onSetSnap12" />
        <button id="snap16Btn" text="1/16" x="220" y="68" width="60" height="24" action="onSetSnap16" />
        <button id="snap24Btn" text="1/24" x="10" y="98" width="65" height="24" action="onSetSnap24" />
        <button id="snap32Btn" text="1/32" x="80" y="98" width="65" height="24" action="onSetSnap32" />
        <button id="snap48Btn" text="1/48" x="150" y="98" width="65" height="24" action="onSetSnap48" />
        <button id="snap64Btn" text="1/64" x="220" y="98" width="60" height="24" action="onSetSnap64" />
        <button id="quantizeSelectionBtn" text="Snap Notes to Active Grid" x="10" y="145" width="270" height="26" action="onQuantizeSelection" />
    </window>

    <window id="eventInspector" title="Events &amp; Note Inspector" x="975" y="245" width="290" height="235">
        <stepper id="sustainStep" label="Hold Duration (Steps)" default="0" min="0" max="128" step="0.5" precision="1" x="10" y="6" width="270" action="onChangeSustain" />
        <input id="noteTypeInput" label="Active Note Type" text="normal" x="10" y="44" width="270" action="onChangeNoteType" />
        <button id="cycleNoteTypeBtn" text="Cycle Note Type (T)" x="10" y="86" width="270" height="24" action="onCycleNoteType" />
        <input id="eventInput" label="Event Name (e.g. Camera Movement)" text="Camera Movement" x="10" y="116" width="270" action="onSelectEvent" />
        <input id="eventVal1Input" label="Value 1" text="" x="10" y="152" width="130" action="onChangeEventVal1" />
        <input id="eventVal2Input" label="Value 2" text="" x="150" y="152" width="130" action="onChangeEventVal2" />
        <button id="addEventBtn" text="Add Event at Playhead (E)" x="10" y="188" width="130" height="24" action="onAddEventAtPlayhead" />
        <button id="delNoteBtn" text="Delete Note / Event (Del)" x="150" y="188" width="130" height="24" action="onDeleteNote" />
    </window>

    <window id="patternTools" title="DAW Pattern Transformer" x="975" y="490" width="290" height="165">
        <button id="copyBtn" text="Copy (Ctrl+C)" x="10" y="6" width="130" height="24" action="onCopyNotes" />
        <button id="pasteBtn" text="Paste (Ctrl+V)" x="150" y="6" width="130" height="24" action="onPasteNotes" />
        <button id="swapSidesBtn" text="Swap Player &lt;-&gt; Opponent" x="10" y="34" width="270" height="24" action="onSwapLanes" />
        <button id="mirrorLanesBtn" text="Mirror Lanes (L &lt;-&gt; R)" x="10" y="62" width="270" height="24" action="onMirrorLanes" />
        <button id="doubleSpeedNotesBtn" text="Compress 2x" x="10" y="90" width="130" height="24" action="onCompressNotes" />
        <button id="humanizeOffsetBtn" text="Humanize Jitter" x="150" y="90" width="130" height="24" action="onHumanizeOffsets" />
        <button id="clearSectionBtn" text="Clear Section Notes" x="10" y="120" width="270" height="24" action="onClearSection" />
    </window>
</editor>