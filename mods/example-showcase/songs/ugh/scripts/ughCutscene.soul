package;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import flixel.util.FlxTimer;
import soulscorch.backend.assets.Paths;
import soulscorch.gameplay.FunkinSprite;
import soulscorch.gameplay.PlayState;

var tankmanSpr:FunkinSprite = null;
var tankTalk1 = null;
var tankTalk2 = null;
var bfBeep = null;
var distorto = null;
var timers:Array<FlxTimer> = [];

function onCreate() {
    // 1. Lock PlayState & Frame Camera
    game.inCutscene = true;
    game.camHUD.visible = false;
    FlxTween.tween(game.camGame, {zoom: 1.05}, 0.8, {ease: FlxEase.quadInOut});

    // 2. Spawn Animated Cutscene Tankman with Sparrow Atlas
    tankmanSpr = new FunkinSprite(game.dad.x + 520, game.dad.y + 225);
    tankmanSpr.antialiasing = true;
    
    // Load Sparrow Frames (NOT raw BitmapData)
    var atlas = Paths.getSparrowAtlas("game/cutscenes/tank/ugh-tankman");
    if (atlas == null) atlas = Paths.getSparrowAtlas("cutscenes/tank/ugh-tankman");
    if (atlas == null) atlas = Paths.getSparrowAtlas("characters/tankman/ugh-tankman");

    if (atlas != null) {
        tankmanSpr.frames = atlas;
        tankmanSpr.animation.addByPrefix("talk1", "TANK TALK 1 P1", 24, false);
        tankmanSpr.animation.addByPrefix("talk2", "TANK TALK 1 P2", 24, false);
    }
    
    tankmanSpr.updateHitbox();
    game.add(tankmanSpr);
    game.dad.visible = false;

    // 3. Center Camera on Tankman
    game.camFollow.setPosition(game.dad.getMidpoint().x + 180, game.dad.getMidpoint().y - 120);

    // 4. Audio Streams
    tankTalk1 = Paths.sound("cutscenes/tank/ugh-1");
    tankTalk2 = Paths.sound("cutscenes/tank/ugh-2");
    bfBeep = Paths.sound("cutscenes/tank/ugh-beep");

    distorto = FlxG.sound.load(Paths.music("DISTORTO"));
    if (distorto != null) {
        distorto.volume = 0;
        distorto.play(false);
        distorto.fadeIn(3.0, 0.0, 0.5);
    }

    // 5. Part 1: Tankman speaks
    if (tankmanSpr.animation.getByName("talk1") != null) {
        tankmanSpr.animation.play("talk1", true);
    }
    if (tankTalk1 != null) tankTalk1.play();

    // 6. Choreographed Sequence Timeline
    addTimer(3.0, function() {
        // Pan to Boyfriend
        FlxTween.tween(game.camGame, {zoom: 1.15}, 0.4, {ease: FlxEase.quadOut});
        game.camFollow.setPosition(game.boyfriend.getMidpoint().x - 120, game.boyfriend.getMidpoint().y - 80);

        addTimer(0.4, function() {
            // BF Beep animation
            game.boyfriend.playAnim("singUP", true);
            if (bfBeep != null) {
                bfBeep.play();
                bfBeep.onComplete = function() {
                    game.boyfriend.dance();
                };
            }

            addTimer(1.4, function() {
                // Pan back to Tankman for Part 2
                FlxTween.tween(game.camGame, {zoom: 1.0}, 0.5, {ease: FlxEase.quadInOut});
                game.camFollow.setPosition(game.dad.getMidpoint().x + 180, game.dad.getMidpoint().y - 120);

                if (tankmanSpr.animation.getByName("talk2") != null) {
                    tankmanSpr.animation.play("talk2", true);
                }
                if (tankTalk2 != null) tankTalk2.play();

                addTimer(6.0, function() {
                    if (distorto != null) distorto.fadeOut(1.0, 0.0);
                    cleanup();
                });
            });
        });
    });
}

function addTimer(delay:Float, callback:Void->Void) {
    var tmr = new FlxTimer().start(delay, function(_) {
        callback();
    });
    timers.push(tmr);
}

function cleanup() {
    for (t in timers) t.cancel();

    if (tankmanSpr != null) {
        game.remove(tankmanSpr);
        tankmanSpr.destroy();
    }

    if (distorto != null) {
        distorto.stop();
        distorto.destroy();
    }

    game.dad.visible = true;
    game.camHUD.visible = true;
    game.inCutscene = false;

    // Reset default camera target and trigger song start countdown
    game.moveCamera(true);
    if (game.startCountdown != null) {
        game.startCountdown();
    }
}