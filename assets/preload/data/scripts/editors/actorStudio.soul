// Actor Studio Pro Engine Controller
var activeCharacter = "bf";
var charActor = null;
var animList = [];
var curAnimIndex = 0;
var isGhostEnabled = true;

function onCreate() {
    Logger.info("[ActorStudio] Initializing Actor Studio Matrix...", "editor");
    loadCharacterData(activeCharacter);
}

function loadCharacterData(charName) {
    activeCharacter = charName;
    if (charActor != null) game.remove(charActor);

    charActor = new Character(FlxG.width * 0.45, FlxG.height * 0.35, charName, (charName == "bf" || charName.startsWith("bf")));
    game.add(charActor);

    animList = charActor.animationsArray != null ? charActor.animationsArray : [];
    updateUI();
}

function updateScale(val) {
    if (charActor != null) {
        charActor.scale.set(val, val);
        charActor.updateHitbox();
    }
}

function updateSing(val) {
    if (charActor != null) charActor.holdLoopDuration = val;
}

function updateIcon(iconName) {
    if (charActor != null) charActor.healthIcon = iconName;
}

function toggleGhost(checked) {
    isGhostEnabled = checked;
}

function toggleFlip(checked) {
    if (charActor != null) {
        charActor.flipX = checked;
    }
}

function updateCamX(val) {
    if (charActor != null) charActor.cameraOffset[0] = val;
}

function updateCamY(val) {
    if (charActor != null) charActor.cameraOffset[1] = val;
}

function removeAnim() {
    if (animList.length > 0) {
        var removed = animList.splice(curAnimIndex, 1);
        Logger.info("[ActorStudio] Removed animation node.", "editor");
        updateUI();
    }
}

function updateUI() {
    var txt = editor.widgets.get("curAnimTxt");
    if (txt != null && charActor != null && charActor.animation.curAnim != null) {
        txt.text = "Anim: " + charActor.animation.curAnim.name;
    }
}