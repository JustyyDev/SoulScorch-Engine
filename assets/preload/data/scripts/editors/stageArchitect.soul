var activeLayer = "behindDad";
var layers = ["background", "behindGF", "behindDad", "behindBF", "foreground"];
var stageProps = [];

function onCreate() {
    showToast("Stage Architect System Ready", false);
}

function onAddProp() {
    var p = new FlxSprite(FlxG.width * 0.5 - 50, FlxG.height * 0.5 - 50);
    p.makeGraphic(100, 100, 0xFFFFFFFF);
    stageProps.push(p);
    editor.add(p);
    showToast("Prop added to stage hierarchy", false);
}

function onRemoveProp() {
    if (stageProps.length > 0) {
        var p = stageProps.pop();
        editor.remove(p);
        p.destroy();
        showToast("Prop removed from stage hierarchy", false);
    }
}

function onScaleX(val) {
    if (stageProps.length > 0 && val != null) {
        stageProps[stageProps.length - 1].scale.x = val;
    }
}

function onScaleY(val) {
    if (stageProps.length > 0 && val != null) {
        stageProps[stageProps.length - 1].scale.y = val;
    }
}

function onScrollX(val) {
    if (stageProps.length > 0 && val != null) {
        stageProps[stageProps.length - 1].scrollFactor.x = val;
    }
}

function onScrollY(val) {
    if (stageProps.length > 0 && val != null) {
        stageProps[stageProps.length - 1].scrollFactor.y = val;
    }
}

function onAlpha(val) {
    if (stageProps.length > 0 && val != null) {
        stageProps[stageProps.length - 1].alpha = val;
    }
}

function onAntialias(val) {
    if (stageProps.length > 0) {
        stageProps[stageProps.length - 1].antialiasing = (val == true);
    }
}

function onCycleLayer() {
    var nextIdx = (layers.indexOf(activeLayer) + 1) % layers.length;
    activeLayer = layers[nextIdx];
    if (editor != null && editor.widgets != null && editor.widgets.exists("layerTxt")) {
        editor.widgets.get("layerTxt").text = "Layer: " + activeLayer;
    }
    showToast("Selected Layer: " + activeLayer, false);
}

function onSaveStage() {
    showToast("Stage architecture exported to .xmsoul.", false);
}

function onResetView() {
    if (camWorld != null) {
        camWorld.zoom = 1.0;
        camWorld.scroll.set(0, 0);
    }
}

function onExit() {
    FlxG.switchState(new MainMenuState());
}