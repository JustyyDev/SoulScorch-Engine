var curScale = 1.0;
var curSing = 4.0;
var camOffsetX = 0.0;
var camOffsetY = 0.0;
var isGhost = true;
var isFlipped = false;

function onCreate() {
    showToast("Actor Studio Engine Ready", false);
}

function onUpdateScale(val) {
    if (val != null) curScale = val;
}

function onUpdateSing(val) {
    if (val != null) curSing = val;
}

function onUpdateIcon(val) {
    showToast("Health Icon updated to: " + val, false);
}

function onUpdateCamX(val) {
    if (val != null) camOffsetX = val;
}

function onUpdateCamY(val) {
    if (val != null) camOffsetY = val;
}

function onToggleGhost(val) {
    isGhost = (val == true);
    showToast("Ghost Overlay: " + (isGhost ? "ENABLED" : "DISABLED"), false);
}

function onToggleFlip(val) {
    isFlipped = (val == true);
}

function onAddAnimModal() {
    showToast("Opening animation dialog...", false);
}

function onRemoveAnim() {
    showToast("Selected animation removed.", false);
}

function onResetOffsets() {
    showToast("Offsets reset to [0, 0].", false);
}

function onSaveActor() {
    showToast("Saved character profile to .xmsoul.", false);
}

function onReloadAtlas() {
    showToast("Sparrow Atlas reloaded from disk.", false);
}

function onExit() {
    FlxG.switchState(new MainMenuState());
}