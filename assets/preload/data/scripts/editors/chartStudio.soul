var isPlaying = false;
var masterBpm = 120.0;
var scrollSpeed = 2.0;
var snapDiv = 16;
var activeStrumline = 2;
var curNoteType = "normal";
var curSustain = 0.0;

function onCreate() {
    showToast("SOULSCORCH Chart Studio Engine Ready", false);
}

function onTogglePlayback() {
    isPlaying = !isPlaying;
    showToast(isPlaying ? "Playback: PLAY" : "Playback: PAUSE", false);
}

function onChangeBPM(val) {
    masterBpm = (val != null) ? val : 120.0;
    showToast("Master BPM: " + masterBpm, false);
}

function onChangeSpeed(val) {
    scrollSpeed = (val != null) ? val : 2.0;
}

function onChangeStage(val) {
    showToast("Stage: " + val, false);
}

function onChangeStrumline(val) {
    activeStrumline = (val != null) ? Std.int(val) : 2;
    showToast("Active Strumline: " + activeStrumline, false);
}

function onChangePlayer(val) {
    showToast("Player: " + val, false);
}

function onChangeOpponent(val) {
    showToast("Opponent: " + val, false);
}

function onSetSnap4() { setSnap(4, "Red"); }
function onSetSnap8() { setSnap(8, "Blue"); }
function onSetSnap12() { setSnap(12, "Purple"); }
function onSetSnap16() { setSnap(16, "Yellow"); }
function onSetSnap24() { setSnap(24, "Pink"); }
function onSetSnap32() { setSnap(32, "Orange"); }
function onSetSnap48() { setSnap(48, "Cyan"); }
function onSetSnap64() { setSnap(64, "Green"); }

function setSnap(div, colName) {
    snapDiv = div;
    if (editor != null && editor.widgets != null && editor.widgets.exists("currentSnapTxt")) {
        editor.widgets.get("currentSnapTxt").text = "Active Snap: 1/" + div + " (" + colName + ")";
    }
}

function onChangeSnapDiv(val) {
    if (val != null) snapDiv = Std.int(val);
}

function onChangeSustain(val) {
    curSustain = (val != null) ? val : 0.0;
}

function onChangeNoteType(val) {
    curNoteType = val;
}

function onCycleNoteType() {
    var types = ["normal", "hurt note", "mine", "instakill", "noanim", "Alt Anim Note"];
    var nextIdx = (types.indexOf(curNoteType) + 1) % types.length;
    curNoteType = types[nextIdx];
    if (editor != null && editor.widgets != null && editor.widgets.exists("noteTypeInput")) {
        editor.widgets.get("noteTypeInput").text = curNoteType;
    }
    showToast("Note Type: " + curNoteType, false);
}

function onSetInstVol(val) {}
function onSetVoiceVol(val) {}
function onChangePlaybackRate(val) {}
function onSetHitsoundVol(val) {}
function onSetMetroVol(val) {}
function onToggleVocalWaveform(val) {}
function onToggleInstWaveform(val) {}
function onResyncAudio() { showToast("Audio Re-synced", false); }

function onSelectEvent(val) {}
function onChangeEventVal1(val) {}
function onChangeEventVal2(val) {}
function onAddEventAtPlayhead() { showToast("Event Placed", false); }
function onDeleteNote() { showToast("Note Removed", false); }

function onCopyNotes() { showToast("Notes Copied", false); }
function onPasteNotes() { showToast("Notes Pasted", false); }
function onSwapLanes() { showToast("Lanes Inverted", false); }
function onMirrorLanes() { showToast("Lanes Mirrored", false); }
function onCompressNotes() { showToast("Compressed 2x", false); }
function onHumanizeOffsets() { showToast("Jitter Humanized", false); }
function onClearSection() { showToast("Section Cleared", false); }
function onQuantizeSelection() { showToast("Snapped to Grid", false); }

function onTogglePracticeBench() { showToast("Toggled Practice Mode", false); }
function onUndo() { showToast("Undo Step", false); }
function onRedo() { showToast("Redo Step", false); }
function onToggleMetronome() { showToast("Toggled Metronome", false); }
function onToggleHitsounds() { showToast("Toggled Hitsounds", false); }
function onToggleWaveform() { showToast("Toggled Waveform Visualizer", false); }
function onReloadChart() { showToast("Chart Reloaded from Disk", false); }

function onSaveSoulChart() {
    showToast("Exported .xmsoul chart successfully", false);
}

function onExportLegacyJson() {
    showToast("Exported legacy JSON chart successfully", false);
}

function onTestInGame() {
    showToast("Booting Playtest...", false);
    FlxG.switchState(new PlayState());
}

function onExit() {
    FlxG.switchState(new MainMenuState());
}

function onUpdate(elapsed) {
    if (FlxG.keys.justPressed.SPACE) onTogglePlayback();
    if (FlxG.keys.justPressed.T) onCycleNoteType();
    if (FlxG.keys.justPressed.ENTER) onTestInGame();
}