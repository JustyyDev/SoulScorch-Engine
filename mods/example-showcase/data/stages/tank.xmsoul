<?xml version="1.0" encoding="utf-8"?>
<stage name="tank" defaultZoom="0.9" cameraSpeed="1.0" hideGirlfriend="false">
    <!-- Actor Spawn Coordinates -->
    <positions>
        <boyfriend x="770" y="450" />
        <dad x="100" y="100" />
        <girlfriend x="400" y="130" />
    </positions>

    <!-- Visual Props & Parallax Layers -->
    <layers>
        <piece name="sky" sprite="stages/tank/tankSky" x="-400" y="-400" scrollX="0.0" scrollY="0.0" scaleX="1.0" scaleY="1.0" layer="background" antialiasing="true" />
        <piece name="clouds" sprite="stages/tank/tankClouds" x="-700" y="-100" scrollX="0.1" scrollY="0.1" scaleX="1.0" scaleY="1.0" layer="background" antialiasing="true" />
        <piece name="mountains" sprite="stages/tank/tankMountains" x="-300" y="-20" scrollX="0.2" scrollY="0.2" scaleX="1.2" scaleY="1.2" layer="background" antialiasing="true" />
        <piece name="buildings" sprite="stages/tank/tankBuildings" x="-200" y="0" scrollX="0.3" scrollY="0.3" scaleX="1.1" scaleY="1.1" layer="background" antialiasing="true" />
        <piece name="ruins" sprite="stages/tank/tankRuins" x="-200" y="0" scrollX="0.35" scrollY="0.35" scaleX="1.1" scaleY="1.1" layer="background" antialiasing="true" />
        <piece name="ground" sprite="stages/tank/tankGround" x="-420" y="-150" scrollX="1.0" scrollY="1.0" scaleX="1.15" scaleY="1.15" layer="behindDad" antialiasing="true" />
    </layers>
</stage>