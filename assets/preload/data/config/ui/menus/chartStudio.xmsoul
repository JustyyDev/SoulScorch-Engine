<?xml version="1.0" encoding="utf-8"?>
<editor title="SOULSCORCH CHART STUDIO // [ULTIMATE DAW HYBRID MATRIX]" script="data/scripts/editors/chartStudio.soul">
    <!-- Top Global Action Bar -->
    <action label="Play/Pause (Space)" onTrigger="onTogglePlayback" />
    <action label="Practice Mode (Tab)" onTrigger="onTogglePracticeBench" />
    <action label="Save .xmsoul (Ctrl+S)" onTrigger="onSaveSoulChart" />
    <action label="Export JSON (Ctrl+E)" onTrigger="onExportLegacyJson" />
    <action label="Undo (Ctrl+Z)" onTrigger="onUndo" />
    <action label="Redo (Ctrl+Y)" onTrigger="onRedo" />
    <action label="Metronome (M)" onTrigger="onToggleMetronome" />
    <action label="Hitsounds (H)" onTrigger="onToggleHitsounds" />
    <action label="Test (Enter)" onTrigger="onTestInGame" />
    <action label="Exit (Esc)" onTrigger="onExit" />

    <!-- Massive Central DAW Note Grid & Timeline Viewport -->
    <canvas id="chartGridCanvas" x="310" y="40" width="700" height="675" backgroundColor="0xFF0D0D12" gridLines="true" waveforms="true" playheadScrubber="true" />

    <!-- Left Dock: Song Configuration & Multi-Track Audio Mixer -->
    <window id="songProps" title="Song Setup &amp; Strumlines" x="10" y="40" width="290" height="330">
        <stepper id="bpmStep" label="Master BPM" default="120" min="30" max="600" step="1" precision="1" x="10" y="8" width="270" action="onChangeBPM" />
        <stepper id="speedStep" label="Scroll Speed" default="2" min="0.5" max="10" step="0.05" precision="2" x="10" y="44" width="270" action="onChangeSpeed" />
        <input id="inputStage" label="Stage ID" text="stage" x="10" y="80" width="270" action="onChangeStage" />
        <stepper id="strumlineSelect" label="Active Strumline (0:GF, 1:Dad, 2:BF)" default="2" min="0" max="8" step="1" precision="0" x="10" y="122" width="270" action="onChangeStrumline" />
        <input id="inputPlayer" label="Player 1 (BF)" text="bf" x="10" y="164" width="125" action="onChangePlayer" />
        <input id="inputOpponent" label="Player 2 (Dad)" text="dad" x="145" y="164" width="125" action="onChangeOpponent" />
        <button id="exportSoulChartBtn" text="Save .xmsoul Chart" x="10" y="218" width="270" height="26" action="onSaveSoulChart" />
        <button id="exportJsonBtn" text="Export Legacy JSON" x="10" y="250" width="270" height="26" action="onExportLegacyJson" />
        <button id="reloadChartBtn" text="Reload from Disk" x="10" y="282" width="270" height="26" action="onReloadChart" />
    </window>

    <window id="audioMixer" title="Multi-Track Audio &amp; Waveforms" x="10" y="375" width="290" height="340">
        <stepper id="instVolStep" label="Inst Volume" default="1" min="0" max="2" step="0.05" precision="2" x="10" y="8" width="125" action="onSetInstVol" />
        <stepper id="voiceVolStep" label="Vocal Volume" default="1" min="0" max="2" step="0.05" precision="2" x="145" y="8" width="125" action="onSetVoiceVol" />
        <stepper id="rateStep" label="Playback Pitch / Rate" default="1" min="0.25" max="3" step="0.05" precision="2" x="10" y="44" width="270" action="onChangePlaybackRate" />
        <stepper id="hitsoundVolStep" label="Hitsound Vol" default="0.7" min="0" max="1" step="0.05" precision="2" x="10" y="80" width="125" action="onSetHitsoundVol" />
        <stepper id="metroVolStep" label="Metronome Vol" default="0.6" min="0" max="1" step="0.05" precision="2" x="145" y="80" width="125" action="onSetMetroVol" />
        <checkbox id="waveformVoiceCheck" label="Render Vocal Waveform" checked="true" x="10" y="125" action="onToggleVocalWaveform" />
        <checkbox id="waveformInstCheck" label="Render Instrumental Waveform" checked="true" x="10" y="152" action="onToggleInstWaveform" />
        <stepper id="audioOffsetStep" label="Audio Offset (ms)" default="0" min="-500" max="500" step="5" precision="0" x="10" y="188" width="270" action="onChangeAudioOffset" />
        <button id="resyncAudioBtn" text="Force Audio Re-sync (S)" x="10" y="235" width="270" height="26" action="onResyncAudio" />
        <button id="tapTempoBtn" text="Tap Tempo (Space / Tap)" x="10" y="268" width="270" height="26" action="onTapTempo" />
    </window>

    <!-- Right Dock: Quantization, Inspectors & DAW Transformer Tools -->
    <window id="quantizationWin" title="Quantization &amp; Grid Snaps" x="1015" y="40" width="255" height="185">
        <text id="currentSnapTxt" text="Active Snap: 1/16 (Yellow)" x="10" y="6" size="12" color="0xFFFFFF00" />
        <stepper id="snapDivStep" label="Snap Division (1/X)" default="16" min="1" max="192" step="1" precision="0" x="10" y="26" width="235" action="onChangeSnapDiv" />
        <button id="snap4Btn" label="1/4" text="1/4" x="10" y="64" width="53" height="22" action="onSetSnap4" />
        <button id="snap8Btn" label="1/8" text="1/8" x="68" y="64" width="53" height="22" action="onSetSnap8" />
        <button id="snap12Btn" label="1/12" text="1/12" x="126" y="64" width="53" height="22" action="onSetSnap12" />
        <button id="snap16Btn" label="1/16" text="1/16" x="184" y="64" width="61" height="22" action="onSetSnap16" />
        <button id="snap24Btn" label="1/24" text="1/24" x="10" y="90" width="53" height="22" action="onSetSnap24" />
        <button id="snap32Btn" label="1/32" text="1/32" x="68" y="90" width="53" height="22" action="onSetSnap32" />
        <button id="snap48Btn" label="1/48" text="1/48" x="126" y="90" width="53" height="22" action="onSetSnap48" />
        <button id="snap64Btn" label="1/64" text="1/64" x="184" y="90" width="61" height="22" action="onSetSnap64" />
        <button id="quantizeSelectionBtn" text="Snap Notes to Grid" x="10" y="125" width="235" height="24" action="onQuantizeSelection" />
    </window>

    <window id="eventInspector" title="Events &amp; Note Inspector" x="1015" y="230" width="255" height="230">
        <stepper id="sustainStep" label="Hold Duration (Steps)" default="0" min="0" max="128" step="0.5" precision="1" x="10" y="6" width="235" action="onChangeSustain" />
        <input id="noteTypeInput" label="Active Note Type" text="normal" x="10" y="44" width="235" action="onChangeNoteType" />
        <button id="cycleNoteTypeBtn" text="Cycle Note Type (T)" x="10" y="86" width="235" height="22" action="onCycleNoteType" />
        <input id="eventInput" label="Event Name" text="Camera Focus" x="10" y="115" width="235" action="onSelectEvent" />
        <input id="eventVal1Input" label="Value 1" text="" x="10" y="152" width="112" action="onChangeEventVal1" />
        <input id="eventVal2Input" label="Value 2" text="" x="128" y="152" width="117" action="onChangeEventVal2" />
        <button id="addEventBtn" text="Add Event" x="10" y="188" width="112" height="24" action="onAddEventAtPlayhead" />
        <button id="delNoteBtn" text="Delete" x="128" y="188" width="117" height="24" action="onDeleteNote" />
    </window>

    <window id="patternTools" title="DAW Pattern Transformer" x="1015" y="465" width="255" height="250">
        <button id="copyBtn" text="Copy (Ctrl+C)" x="10" y="6" width="112" height="22" action="onCopyNotes" />
        <button id="pasteBtn" text="Paste (Ctrl+V)" x="128" y="6" width="117" height="22" action="onPasteNotes" />
        <button id="swapSidesBtn" text="Swap Player &lt;-&gt; Opponent" x="10" y="32" width="235" height="22" action="onSwapLanes" />
        <button id="mirrorLanesBtn" text="Mirror Lanes (L &lt;-&gt; R)" x="10" y="58" width="235" height="22" action="onMirrorLanes" />
        <button id="doubleSpeedNotesBtn" text="Compress 2x" x="10" y="84" width="112" height="22" action="onCompressNotes" />
        <button id="humanizeOffsetBtn" text="Humanize Jitter" x="128" y="84" width="117" height="22" action="onHumanizeOffsets" />
        <button id="shiftNotesLeftBtn" text="Shift Lane &lt;&lt;" x="10" y="110" width="112" height="22" action="onShiftNotesLeft" />
        <button id="shiftNotesRightBtn" text="Shift Lane &gt;&gt;" x="128" y="110" width="117" height="22" action="onShiftNotesRight" />
        <button id="invertNotesBtn" text="Invert Note Selection" x="10" y="136" width="235" height="22" action="onInvertNotes" />
        <button id="clearSectionBtn" text="Clear Section Notes" x="10" y="166" width="235" height="24" action="onClearSection" />
        <button id="addNewSectionBtn" text="+ Add New Song Section" x="10" y="196" width="235" height="24" action="onAddNewSection" />
    </window>
</editor>