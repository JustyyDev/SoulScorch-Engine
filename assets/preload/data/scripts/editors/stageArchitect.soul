var activeLayer = "behindDad";
var layers = ["background", "behindGF", "behindDad", "behindBF", "foreground"];

function onCreate() {
    showToast("Stage Architect System Ready", false);
}

function onAddProp() {
    showToast("Prop added to stage hierarchy", false);
}

function onRemoveProp() {
    showToast("Prop removed from stage hierarchy", false);
}

function onCycleLayer() {
    var nextIdx = (layers.indexOf(activeLayer) + 1) % layers.length;
    activeLayer = layers[nextIdx];
    if (editor.widgets.exists("layerTxt")) {
        editor.widgets.get("layerTxt").text = "Layer: " + activeLayer;
    }
    showToast("Selected Layer: " + activeLayer, false);
}

function onSaveStage() {
    showToast("Stage architecture exported to .xmsoul", false);
}

function onResetView() {
    if (camWorld != null) {
        camWorld.zoom = 1.0;
        camWorld.scroll.set(0, 0);
    }
}

function onExit() {
    FlxG.switchState(new MainMenuState());
}