<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- Application Metadata -->
	<app title="SoulScorch Engine" file="SoulScorch" main="Main" package="com.soulscorch.engine" version="1.0.0" company="SoulScorch Studios" />

	<!-- Core Framework Libraries -->
	<haxelib name="lime" />
	<haxelib name="openfl" />
	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="flixel-ui" />
	<haxelib name="away3d" />
	<haxelib name="hscript" />

	<!-- Flixel 5.6.2 ConsoleUtil Private Access Fix for hscript 2.5.0+ -->
	<haxeflag name="--macro" value="addGlobalMetadata('flixel.system.debug.console.ConsoleUtil', '@:access(hscript.Interp)')" />

	<!-- Scripting Backends (Iris + Optional LuaJIT Support) -->
    <haxelib name="hscript-iris" />
    <haxedef name="SOULSCORCH_IRIS" />

    <!-- Optional LuaJIT Backend (Only compiles if linc_luajit is installed and allowed) -->
    <haxelib name="linc_luajit" if="cpp and SOULSCORCH_LUA" />
    <haxedef name="LUA_ALLOWED" if="cpp and SOULSCORCH_LUA" />
    <haxedef name="SOULSCORCH_LUAJIT" if="cpp and SOULSCORCH_LUA" />
	
	<!-- Optional Video Codecs -->
	<haxelib name="hxvlc" if="SOULSCORCH_VIDEO_HXVLC" />
	<haxelib name="hxCodec" if="SOULSCORCH_VIDEO_HXCODEC" />

	<!-- Discord Rich Presence (Desktop C++ Targets) -->
	<haxelib name="hxdiscord_rpc" if="desktop" unless="mobile" />

	<!-- Custom Application Icons -->
	<icon path="art/iconOG.png" />
	<assets path="art/iconOG.png" id="iconOG" />

	<!-- Window Configuration -->
	<window width="1280" height="720" background="0x000000" hardware="true" vsync="false" fps="120" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" />
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" />

	<!-- Android Configuration -->
	<config:android minimum-sdk-version="21" target-sdk-version="34" if="android" />
	<setenv name="ANDROID_PERMISSIONS" value="android.permission.READ_EXTERNAL_STORAGE,android.permission.WRITE_EXTERNAL_STORAGE,android.permission.INTERNET,android.permission.VIBRATE,android.permission.WAKE_LOCK,android.permission.ACCESS_NETWORK_STATE" if="android" />

	<!-- iOS Configuration -->
	<ios deployment="13.0" devices="universal" if="ios" />

	<!-- Source Roots -->
	<source path="source" />

	<!-- Core Asset Pipelines (Single Consolidated Map) -->
	<assets path="assets/preload" rename="assets" exclude="*.ogg" if="web" />
	<assets path="assets/preload" rename="assets" exclude="*.mp3" unless="web" embed="false" />
	<assets path="assets/preload" rename="assets" embed="true" if="mobile" />

	<!-- External Mods Folder (Kept at Root for Modders) -->
	<assets path="mods" rename="mods" embed="false" unless="mobile" />

	<!-- Engine Optimization & Crash Prevention Flags -->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="analyzer-optimize" unless="debug" />
	<haxedef name="message.reporting" value="pretty" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	<haxedef name="hscriptPos" />

	<!-- Completely Disable PCH to Avoid Stale Collisions -->
	<set name="HXCPP_NO_PCH" value="1" />

	<!-- Custom SoulScorch Defines -->
	<haxedef name="SOULSCORCH_MODS_ENABLED" />
	<haxedef name="SOULSCORCH_EXPERIMENTAL_SHADERS" if="desktop" />
	<haxedef name="SOULSCORCH_SOFTCODED_UI" />

	<!-- Warning Suppressions -->
	<haxeflag name="-w" value="-WDeprecated" />
	<haxeflag name="-w" value="-WDeprecatedEnumAbstract" />

	<!-- Desktop Crash & Stack Tracing -->
	<section if="desktop">
		<haxedef name="HXCPP_CHECK_POINTER" if="debug" />
		<haxedef name="HXCPP_STACK_LINE" if="debug" />
	</section>

	<!-- High-Speed Windows C++ Build Optimizations -->
	<section if="windows">
		<haxedef name="HXCPP_GC_BIG_BLOCKS" />

		<!-- Native Windows Libraries for NativeAPI -->
		<dependency name="dwmapi.lib" />
		<dependency name="user32.lib" />
		<dependency name="shell32.lib" />
		<dependency name="gdi32.lib" />

		<!-- Force MSVC Conformant Preprocessor & Undefine Windows Macro Conflicts -->
		<cppflag value="/Zc:preprocessor" />
		<cppflag value="/Uconstant" />

		<!-- Verbose Build Logs -->
		<set name="HXCPP_VERBOSE" value="1" />

		<!-- Dynamic Discord RPC DLL Deployment -->
		<copy file="${haxelib:hxdiscord_rpc}/lib/windows/discord-rpc.dll" to="discord-rpc.dll" if="cpp" />
	</section>

	<!-- Linux Desktop Flags & Libraries -->
	<section if="linux">
		<dependency name="libudev" />
		<dependency name="libdbus-1" />
	</section>

	<!-- Mobile / Web Embedded Stripping -->
	<haxedef name="openfl-disable-mouse" if="mobile" />
	<haxedef name="disable-cffi" if="cppia" />
</project>