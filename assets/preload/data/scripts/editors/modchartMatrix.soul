function onCreate() {
    showToast("Modchart Matrix Engine Ready", false);
}

function onPlaySequence() {
    showToast("Executing modchart timeline sequence...", false);
}

function onSaveModifiers() {
    showToast("Exported modifier tags to modifiers.xmsoul", false);
}

function onSwayX(val) {
    showToast("Lane Sway X: " + val, false);
}

function onRotate(val) {
    showToast("Lane Angle: " + val + "°", false);
}

function onShaderChange(name) {
    showToast("Compiled shader hook: " + name, false);
}

function onExit() {
    FlxG.switchState(new MainMenuState());
}