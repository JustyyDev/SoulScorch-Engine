<?xml version="1.0" encoding="utf-8"?>
<noteSkin name="default" type="sparrow" sprite="NOTE_assets" scale="0.7" antialiasing="true">
    <strums>
        <strum lane="0" static="arrowLEFT" press="left press" confirm="left confirm" />
        <strum lane="1" static="arrowDOWN" press="down press" confirm="down confirm" />
        <strum lane="2" static="arrowUP" press="up press" confirm="up confirm" />
        <strum lane="3" static="arrowRIGHT" press="right press" confirm="right confirm" />
    </strums>

    <notes>
        <note lane="0" anim="purple" />
        <note lane="1" anim="blue" />
        <note lane="2" anim="green" />
        <note lane="3" anim="red" />
    </notes>

    <sustains alpha="0.6">
        <hold lane="0" piece="purple hold piece" end="pruple end hold" />
        <hold lane="1" piece="blue hold piece" end="blue hold end" />
        <hold lane="2" piece="green hold piece" end="green hold end" />
        <hold lane="3" piece="red hold piece" end="red hold end" />
    </sustains>
</noteSkin>