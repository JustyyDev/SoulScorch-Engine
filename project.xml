<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- Application Metadata -->
	<app title="SoulScorch Engine" file="SoulScorch" main="Main" package="com.soulscorch.engine" version="1.0.0" company="SoulScorch Studios" />

	<!-- Core Framework Libraries -->
	<haxelib name="lime" />
	<haxelib name="openfl" />
	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="flixel-ui" />
	<haxelib name="away3d" />
	<haxelib name="hscript" />

	<!-- Flixel 5.6.2 ConsoleUtil Private Access Fix for hscript 2.5.0+ -->
	<haxeflag name="--macro" value="addGlobalMetadata('flixel.system.debug.console.ConsoleUtil', '@:access(hscript.Interp)')" />

	<!-- Scripting Backends (Iris + Desktop Native LuaJIT Support) -->
    <haxelib name="hscript-iris" />
    <haxedef name="SOULSCORCH_IRIS" />

	<section if="desktop" unless="mobile">
		<haxelib name="linc_luajit" if="cpp" />
		<haxedef name="LUA_ALLOWED" if="cpp" />
		<haxedef name="SOULSCORCH_LUA" if="cpp" />
	</section>
	
	<!-- Optional Video Codecs -->
	<haxelib name="hxvlc" if="SOULSCORCH_VIDEO_HXVLC" />
	<haxelib name="hxCodec" if="SOULSCORCH_VIDEO_HXCODEC" />

	<!-- Discord Rich Presence (Desktop C++ Targets) -->
	<haxelib name="hxdiscord_rpc" if="desktop" unless="mobile" />

	<!-- Custom Application Icons -->
	<icon path="art/iconOG.png" />
	<assets path="art/iconOG.png" id="iconOG" />

	<!-- Window Configuration -->
	<window width="1280" height="720" background="0x000000" hardware="true" vsync="false" fps="120" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" />
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" />

	<!-- Android Configuration -->
	<config:android minimum-sdk-version="21" target-sdk-version="34" if="android" />
	<setenv name="ANDROID_PERMISSIONS" value="android.permission.INTERNET,android.permission.VIBRATE,android.permission.WAKE_LOCK,android.permission.ACCESS_NETWORK_STATE" if="android" />

	<!-- iOS Configuration -->
	<ios deployment="13.0" devices="universal" if="ios" />

	<!-- Source Roots -->
	<source path="source" />

	<!-- Core Asset Pipelines (Single Consolidated Map) -->
	<assets path="assets/preload" rename="assets" exclude="*.ogg" if="web" />
	<assets path="assets/preload" rename="assets" exclude="*.mp3" unless="web" embed="false" />

	<!-- External Mods Folder (Kept at Root for Modders) -->
	<assets path="mods" rename="mods" embed="false" unless="mobile" />

	<!-- Shared Engine Assets (logos, built-in art, etc.) -->
	<assets path="assets/shared" rename="assets/shared" embed="false" unless="mobile" />

	<!-- Engine Optimization & Crash Prevention Flags -->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="analyzer-optimize" unless="debug" />
	<haxedef name="message.reporting" value="pretty" />
	<haxedef name="hscriptPos" />

	<!-- Completely Disable PCH to Avoid Stale Collisions -->
	<set name="HXCPP_NO_PCH" value="1" />

	<!-- Mobile Size & Symbol Stripping Optimizations -->
	<haxedef name="HXCPP_STRIP_SYMBOLS" if="release" />
	<haxedef name="NO_PRELOAD_ALL" if="mobile" />

	<!-- Custom SoulScorch Defines -->
	<haxedef name="SOULSCORCH_MODS_ENABLED" />
	<haxedef name="SOULSCORCH_EXPERIMENTAL_SHADERS" if="desktop" />
	<haxedef name="SOULSCORCH_SOFTCODED_UI" />

	<!-- Optional FMOD Audio Backend (requires `haxelib install linc_fmod`) -->
	<!-- FMOD support disabled by default. To enable, uncomment the lines below
	     and ensure the FMOD SDK is available at the FMOD_SDK environment variable. -->
	<!-- <haxedef name="SOULSCORCH_FMOD" if="cpp" /> -->
	<!-- <haxelib name="linc_fmod" if="SOULSCORCH_FMOD" /> -->

	<!-- Physics: NAPE (note-hit particles, soft-body UI, debris VFX) -->
	<!-- The NAPE_RELEASE_BUILD define below is only meaningful once nape is enabled. -->
	<!-- <haxedef name="SOULSCORCH_PHYSICS" /> -->
	<!-- <haxelib name="nape" if="SOULSCORCH_PHYSICS" /> -->
	<haxedef name="NAPE_RELEASE_BUILD" if="SOULSCORCH_PHYSICS" unless="debug" />

	<!-- Deterministic RNG: seedyrng (seeded modcharts, replay/ghost support) -->
	<!-- <haxedef name="SOULSCORCH_SEEDY" /> -->
	<!-- <haxelib name="seedyrng" if="SOULSCORCH_SEEDY" /> -->

	<!-- Serialization: hxbit (compact, fast save/replay/network state) -->
	<!-- <haxedef name="SOULSCORCH_HXBIT" /> -->
	<!-- <haxelib name="hxbit" if="SOULSCORCH_HXBIT" /> -->

	<!-- String/parsing utils: haxe-strings (script arg parsing, chart text) -->
	<!-- <haxedef name="SOULSCORCH_STRINGS" /> -->
	<!-- <haxelib name="haxe-strings" if="SOULSCORCH_STRINGS" /> -->

	<!-- Tweening: actuate (alternative to FlxTween for UI/transition polish) -->
	<!-- <haxedef name="SOULSCORCH_ACTUATE" /> -->
	<!-- <haxelib name="actuate" if="SOULSCORCH_ACTUATE" /> -->

	<!-- Functional helpers: thx.core (math, option/either, ranges) -->
	<!-- <haxedef name="SOULSCORCH_THX" /> -->
	<!-- <haxelib name="thx.core" if="SOULSCORCH_THX" /> -->

	<!-- Networking: hxhttp (online scores, mod download, update checks) -->
	<!-- <haxedef name="SOULSCORCH_NET" /> -->
	<!-- <haxelib name="hxhttp" if="SOULSCORCH_NET" /> -->

	<!-- System integration: systools (registry/shortcuts, desktop launchers) -->
	<!-- <haxedef name="SOULSCORCH_SYSTOOLS" if="desktop" /> -->
	<!-- <haxelib name="systools" if="SOULSCORCH_SYSTOOLS" /> -->

	<!-- Markdown: render mod READMEs / changelogs in-engine -->
	<!-- <haxedef name="SOULSCORCH_MARKDOWN" /> -->
	<!-- <haxelib name="markdown" if="SOULSCORCH_MARKDOWN" /> -->

	<!-- 3D Rendering: soul3d (custom engine 3D layer) or away3d (already core) -->
	<!-- away3d is already a core lib; use it for 3D title backdrops / stages. -->
	<!-- <haxedef name="SOULSCORCH_3D" /> -->
	<!-- <haxelib name="soul3d" if="SOULSCORCH_3D" /> -->

	<!-- GPU Particles: heaps / hxsl for advanced VFX (title sparks, stage dust) -->
	<!-- <haxedef name="SOULSCORCH_PARTICLES" /> -->
	<!-- <haxelib name="heaps" if="SOULSCORCH_PARTICLES" /> -->

	<!-- Warning Suppressions -->
	<haxeflag name="-w" value="-WDeprecated" />
	<haxeflag name="-w" value="-WDeprecatedEnumAbstract" />

	<!-- Desktop Crash & Stack Tracing -->
	<section if="desktop">
		<haxedef name="HXCPP_CHECK_POINTER" if="debug" />
		<haxedef name="HXCPP_STACK_LINE" if="debug" />
	</section>

	<!-- High-Speed Windows C++ Build Optimizations -->
	<section if="windows">
		<haxedef name="HXCPP_GC_BIG_BLOCKS" />

		<!-- Native Windows Libraries for NativeAPI -->
		<dependency name="dwmapi.lib" />
		<dependency name="user32.lib" />
		<dependency name="shell32.lib" />
		<dependency name="gdi32.lib" />

		<!-- Force MSVC Conformant Preprocessor & Undefine Windows Macro Conflicts -->
		<cppflag value="/Zc:preprocessor" />
		<cppflag value="/Uconstant" />

		<!-- Verbose Build Logs -->
		<set name="HXCPP_VERBOSE" value="1" />

		<!-- Dynamic Discord RPC DLL Deployment -->
		<copy file="${haxelib:hxdiscord_rpc}/lib/windows/discord-rpc.dll" to="discord-rpc.dll" if="cpp" />
	</section>

	<!-- Linux Desktop Flags & Libraries -->
	<section if="linux">
		<dependency name="libudev" />
		<dependency name="libdbus-1" />
	</section>

	<!-- Mobile / Web Embedded Stripping -->
	<haxedef name="openfl-disable-mouse" if="mobile" />
	<haxedef name="disable-cffi" if="cppia" />
</project>